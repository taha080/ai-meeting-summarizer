# Copy this file to .env and fill in a key. Never commit .env.
# The default provider is Groq, which is free and does not require a credit card.
# Create a key at https://console.groq.com/keys

PROVIDER=groq

# Required for the default free tier.
GROQ_API_KEY=

# Optional. Chat model. Default: openai/gpt-oss-20b (free, 8k tokens/minute).
GROQ_MODEL=openai/gpt-oss-20b

# Optional. Used when the primary Groq chat model keeps failing.
# Llama models are no longer on the free plan. Leave blank to disable fallback.
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Optional. whisper-large-v3-turbo or whisper-large-v3.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Optional paid provider. Used only when PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional free tier. Used only when PROVIDER=gemini.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
