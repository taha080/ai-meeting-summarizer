# Copy this file to .env and fill in your key. Never commit .env.

# Required. Secret key for the OpenAI API.
OPENAI_API_KEY=

# Optional. Chat model used to summarize transcripts.
OPENAI_MODEL=gpt-4o-mini

# Optional. Audio transcription model: whisper-1 or gpt-4o-transcribe.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
